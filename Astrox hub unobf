local function isFrameHidden(frame)
	if not frame then return false end
	if not frame.Visible then return true end
	local top = getMainGui()
	local p = frame.Parent
	local depth = 0
	while p and p ~= top and depth < 5 do
		if p:IsA("GuiObject") and not p.Visible then return true end
		p = p.Parent
		depth = depth + 1
	end
	if frame.AbsoluteSize.X <= 1 or frame.AbsoluteSize.Y <= 1 then return true end
	if frame:IsA("CanvasGroup") and frame.GroupTransparency >= 0.99 then return true end
	local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
	local vp = workspace.CurrentCamera.ViewportSize
	if pos.X + size.X <= -80 or pos.Y + size.Y <= -80 then return true end
	if pos.X >= vp.X + 80 or pos.Y >= vp.Y + 80 then return true end
	return false
end

