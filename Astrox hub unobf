local function TeleportToRole(targetName)
	if not targetName then WindUI:Notify({Title="Teleport", Content=T("teleport_no_target"), Icon="x-circle", Duration=3}); return end
	local player = Players:FindFirstChild(targetName)
	if not player or not player.Character then WindUI:Notify({Title="Teleport", Content=T("teleport_not_found"), Icon="x-circle", Duration=3}); return end
	local myChar = LocalPlayer.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
	if not myHrp or not targetHrp then WindUI:Notify({Title="Teleport", Content=T("teleport_error"), Icon="x-circle", Duration=3}); return end
	local destPos = targetHrp.Position + Vector3.new(2,0,0)
	pcall(function() myHrp.CFrame = CFrame.new(destPos, targetHrp.Position) end)
	if FlyEnabled and FlyInstances.AlignPos and FlyInstances.AlignPos.Parent then pcall(function() FlyInstances.AlignPos.Position = destPos end) end
	WindUI:Notify({Title="Teleport", Content=T("teleported_to") .. targetName, Icon="check-circle", Duration=3})
end

local function CleanupFlyInstances()
	if FlyInstances.AlignPos then pcall(function() FlyInstances.AlignPos:Destroy() end); FlyInstances.AlignPos = nil end
	if FlyInstances.AlignOri then pcall(function() FlyInstances.AlignOri:Destroy() end); FlyInstances.AlignOri = nil end
	if FlyInstances.Att then pcall(function() FlyInstances.Att:Destroy() end); FlyInstances.Att = nil end
end

local function toggleFly(state)
	local wasEnabled = FlyEnabled
	if state and wasEnabled and FlyInstances.AlignPos and FlyInstances.AlignPos.Parent then return end
	FlyEnabled = state
	if FlyConnection then FlyConnection:Disconnect(); FlyConnection = nil end
	if state and not SuppressFlyNotify then
