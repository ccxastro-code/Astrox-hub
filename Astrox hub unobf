local function getNearestTarget()
	local targets = {}
	local roles2 = ReplicatedStorage:FindFirstChild("GetPlayerData", true):InvokeServer()
	local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localRoot then return nil end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local role = roles2 and roles2[player.Name] and roles2[player.Name].Role
			local humanoid = player.Character:FindFirstChild("Humanoid")
			local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
			if role and humanoid and humanoid.Health > 0 and targetRoot and role ~= "Murderer" then
				table.insert(targets, {Player=player, Distance=(localRoot.Position - targetRoot.Position).Magnitude})
			end
		end
	end
	table.sort(targets, function(a,b) return a.Distance < b.Distance end)
	return targets[1] and targets[1].Player or nil
end

