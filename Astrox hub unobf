local function T(key, ...)
	if key == nil then return "" end
	local t = Translations[Lang] or Translations.en
	local v = t[key] or Translations.en[key] or tostring(key)
	if select("#", ...) > 0 then return string.format(v, ...) end
	return v
end

local LocalizedElements = {}
local function RegTitle(ref, key, kind) table.insert(LocalizedElements, {ref=ref, field="title", key=key, kind=kind}) end
local function RegDesc(ref, key) table.insert(LocalizedElements, {ref=ref, field="desc", key=key, kind="paragraph"}) end
local function RegTitleDyn(ref, fn, kind) table.insert(LocalizedElements, {ref=ref, field="title", dynFn=fn, kind=kind}) end

local UpdateTabTitles
local UpdateKeybindUI

local function RefreshAllText()
	for _, e in ipairs(LocalizedElements) do
		if e.ref then
			local okTxt, txt = pcall(function() return e.dynFn and e.dynFn() or T(e.key) end)
			if not okTxt then txt = T(e.key) end
			pcall(function()
				if e.field == "title" then e.ref:SetTitle(txt)
				elseif e.field == "desc" and e.kind == "paragraph" then e.ref:SetDesc(txt) end
			end)
		end
	end
	if UpdateTabTitles then pcall(UpdateTabTitles) end
	if UpdateKeybindUI then pcall(UpdateKeybindUI) end
end

