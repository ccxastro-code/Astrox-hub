	})
	RegTitle(farmSpeedSlider, "farm_speed", "slider")

	AutoFarmToggleRef = Tabs.AutoFarm:Toggle({
		Title=T("enable_autofarm"),
		Default=false,
		Callback=function(state)
			IsFarming = state
			FarmCtl.Id = FarmCtl.Id + 1
			local sessionId = FarmCtl.Id
			FarmCtl.Log(state and "autofarm ON" or "autofarm OFF")
			if state then
				if FlyEnabled then
					FlyEnabled = false
					if FlyToggle then FlyToggle:Set(false) end
					toggleFly(false)
					task.defer(function() WindUI:Notify({Title="Fly", Content=T("fly_disabled_for_farm"), Icon="info", Duration=4}) end)
				end
				CurrentCoin = nil
				FarmTargetTime = 0
				PushStartTime = 0
				FarmCtl.SawCoins = false
				AutoReset.EmptySince = nil
				ResetCoinCounters()
				WindUI:Notify({Title="AutoFarm", Content=T("autofarm_activated"), Icon="check-circle", Duration=3})

				task.spawn(function()
					local StartTime = os.time()
					while IsFarming and ScriptEnabled and FarmCtl.Id == sessionId do
						task.wait(1)
						local raw = CalculateRawCPH()
						SessionStats.SmoothedRate = SessionStats.SmoothedRate + (raw - SessionStats.SmoothedRate) * RATE_CONFIG.SMOOTHING
						local elapsedSec = os.time() - StartTime
						local minutes = string.format("%02d", math.floor(elapsedSec/60))
						local seconds = string.format("%02d", elapsedSec % 60)
						local hourElapsed = os.clock() - CurrentHourStart
						if hourElapsed >= 3600 then
							table.insert(HourHistory, {coins=CurrentHourCoins})
							if #HourHistory > MAX_HISTORY then table.remove(HourHistory, 1) end
							CurrentHourStart = os.clock(); CurrentHourCoins = 0
						end
						autoFarmStatsParagraph:SetDesc(T("stats_coins_round") .. tostring(ManualCoinCount) .. "\n" .. T("stats_coins_hour") .. tostring(math.floor(SessionStats.SmoothedRate)) .. "\n" .. T("stats_time") .. minutes .. ":" .. seconds .. "\n" .. BuildHistoryText())
					end
				end)

				task.spawn(function()
					while IsFarming and ScriptEnabled and FarmCtl.Id == sessionId do
						-- ⚡ 0.05s entre checks (máximo seguro)
						task.wait(0.05)
						local ok, err = pcall(function()
							if not IsFarming then return end
							GetMap()
							local hrp = GetHRP()
							local hum = GetHumanoid()
							if not hrp or not hum then return end
							if not LP:GetAttribute("Alive") then
								if FarmPhysics.Active then FarmPhysics.Off() end
								CurrentCoin = nil
								AutoReset.EmptySince = nil
								return
							end

							if CurrentCoin then
								local ok2, pos2 = pcall(function()
									if CurrentCoin.Parent then return CurrentCoin.Position end
									return nil
								end)
								if ok2 and pos2 then
									local d = (hrp.Position - pos2).Magnitude
									local prev = MinDistToCoin[CurrentCoin]
									if not prev or d < prev then
										MinDistToCoin[CurrentCoin] = d
									end
								end
							end

							local target = GetNearestCoin(hrp)

							if not target then
								local coinsLeft = CountCoinsLeftInMap()

								if coinsLeft == 0 and FarmCtl.SawCoins and AutoReset.Enabled and not AutoReset.Done then
									if not AutoReset.EmptySince then
										AutoReset.EmptySince = tick()
										FarmCtl.Log("map empty, waiting 1s (count=" .. ManualCoinCount .. ")")
									elseif tick() - AutoReset.EmptySince >= AutoReset.EMPTY_DELAY then
										AutoReset.Done = true
										if FarmCtl.Tween then pcall(function() FarmCtl.Tween:Cancel() end); FarmCtl.Tween = nil end
										FarmPhysics.Off()
										local h = GetHumanoid()
										if h then pcall(function() h.Health = 0 end) end
										WindUI:Notify({Title=T("reset_title"), Content=T("reset_bag_full"), Icon="check-circle", Duration=3})
										FarmCtl.Log("auto reset fired")
										AutoReset.EmptySince = nil
										CurrentCoin = nil
										return
									end
								else
									AutoReset.EmptySince = nil
								end

								if not FarmCtl.SawCoins and hrp then
									local cf = GetUnderMapCF()
									if cf then
										FarmPhysics.On()
										if (hrp.Position - cf.Position).Magnitude > 5 then
											hrp.Velocity = Vector3.zero
											hrp.CFrame = cf
										end
									end
								end
								if FarmCtl.SawCoins then
									if FarmCtl.Tween then pcall(function() FarmCtl.Tween:Cancel() end); FarmCtl.Tween = nil end
									if FarmPhysics.Active then FarmPhysics.Off() end
								end
								CurrentCoin = nil
								return
							end

							FarmCtl.SawCoins = true
							AutoReset.EmptySince = nil
							local tv = target:FindFirstChild("CoinVisual")
							local collected = WasCollected(target, tv)

							if collected then
								CountCoinIfCollected(target)
								CurrentCoin = nil
								return
							end

							if CurrentCoin and CurrentCoin ~= target then
								CountCoinIfCollected(CurrentCoin)
							end

							if target ~= CurrentCoin then
								CurrentCoin = target
								FarmTargetTime = tick()
								PushStartTime = 0
								if not MinDistToCoin[target] then
									local ok2, pos2 = pcall(function() return target.Position end)
									if ok2 and pos2 then
										MinDistToCoin[target] = (hrp.Position - pos2).Magnitude
									end
								end
								MoveToCoin(target)
							else
								local magnitude = (hrp.Position - target.Position).Magnitude
								if magnitude <= 6 and not WasCollected(target, target:FindFirstChild("CoinVisual")) then
									pcall(function()
										target.CFrame = CFrame.new(hrp.Position + Vector3.new(math.random(-80,80)/100, math.random(-50,300)/100, math.random(-80,80)/100))
									end)
									if PushStartTime == 0 then PushStartTime = tick() end
									if tick() - PushStartTime > 2 then
										CurrentCoin = nil
										PushStartTime = 0
									end
								elseif magnitude > 6 then
									if tick() - FarmTargetTime > 4 then
										CoinFailed(target)
										CurrentCoin = nil
										PushStartTime = 0
									end
								end
							end
						end)
						if not ok then FarmCtl.Log("loop err: " .. tostring(err)) end
					end
				end)
			else
				if FarmCtl.Tween then pcall(function() FarmCtl.Tween:Cancel() end); FarmCtl.Tween = nil end
				pcall(FarmPhysics.Off)
				CurrentCoin = nil
				FarmCtl.SawCoins = false
				AutoReset.EmptySince = nil
				if AutoFarmDisableReason then
					WindUI:Notify({Title="AutoFarm", Content=AutoFarmDisableReason, Icon="info", Duration=4})
					AutoFarmDisableReason = nil
				else
					WindUI:Notify({Title="AutoFarm", Content=T("autofarm_deactivated"), Icon="x-circle", Duration=3})
				end
				local char = GetChar()
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp); hum:ChangeState(Enum.HumanoidStateType.Running) end
				end
			end
		end
	})
	RegTitle(AutoFarmToggleRef, "enable_autofarm", "toggle")

	local autoResetToggle = Tabs.AutoFarm:Toggle({
