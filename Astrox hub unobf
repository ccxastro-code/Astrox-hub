UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not ScriptEnabled or unloaded then return end
	if ListeningForBind and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.Escape then
			ListeningForBind = nil; UpdateKeybindUI()
			WindUI:Notify({Title="Keybind", Content=T("keybind_cancelled"), Icon="x-circle", Duration=2})
			return
		end
		if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
			local target = ListeningForBind
			if target == "tp_murder" then TeleportMurderKey=nil; ListeningForBind=nil; UpdateKeybindUI(); WindUI:Notify({Title="Keybind", Content=T("keybind_removed_tp_murder"), Icon="check-circle", Duration=3}); return
			elseif target == "tp_sheriff" then TeleportSheriffKey=nil; ListeningForBind=nil; UpdateKeybindUI(); WindUI:Notify({Title="Keybind", Content=T("keybind_removed_tp_sheriff"), Icon="check-circle", Duration=3}); return
			elseif target == "tp_hero" then TeleportHeroKey=nil; ListeningForBind=nil; UpdateKeybindUI(); WindUI:Notify({Title="Keybind", Content=T("keybind_removed_tp_hero"), Icon="check-circle", Duration=3}); return end
		end
		if input.KeyCode ~= Enum.KeyCode.Unknown and not gameProcessed then
			local target = ListeningForBind
			if target == "noclip" then NoclipKey = input.KeyCode
			elseif target == "fly" then FlyKey = input.KeyCode
			elseif target == "tp_murder" then TeleportMurderKey = input.KeyCode
			elseif target == "tp_sheriff" then TeleportSheriffKey = input.KeyCode
			elseif target == "tp_hero" then TeleportHeroKey = input.KeyCode
			elseif target == "killall" then KillAllKey = input.KeyCode
			elseif target == "grabgun" then GrabGunKey = input.KeyCode end
			ListeningForBind = nil; UpdateKeybindUI()
			local label = T("kb_" .. target)
			WindUI:Notify({Title="Keybind", Content=label .. T("keybind_now") .. input.KeyCode.Name, Icon="check-circle", Duration=3})
		end
		return
	end
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then CtrlPressed = true end
	if CtrlPressed and input.KeyCode == Enum.KeyCode.M then
		if windowOpen then
			if Window and type(Window.Minimize) == "function" then pcall(function() Window:Minimize() end)
			else local frame = getMainFrame(); if frame then frame.Visible = false end end
			showFloatingButton()
		else openMainWindow() end
		return
	end
	if input.KeyCode == NoclipKey then
		local newState = not Settings.Noclip.Enabled
		if NoclipToggleRef then pcall(function() NoclipToggleRef:Set(newState) end) end
		if Settings.Noclip.Enabled ~= newState then Settings.Noclip.Enabled = newState; ToggleNoclip(newState) end
	end
	if input.KeyCode == FlyKey then
		local newState = not FlyEnabled
		if FlyToggle then pcall(function() FlyToggle:Set(newState) end) end
		if FlyEnabled ~= newState then toggleFly(newState) end
	end
	if input.KeyCode == KillAllKey then
		local newState = not killActive
		if KillAllToggleRef then pcall(function() KillAllToggleRef:Set(newState) end) end
		if killActive ~= newState then ToggleKillAll(newState) end
	end
	if input.KeyCode == GrabGunKey then task.spawn(GrabGun) end
	if TeleportMurderKey and input.KeyCode == TeleportMurderKey then TeleportToRole(Murder) end
	if TeleportSheriffKey and input.KeyCode == TeleportSheriffKey then TeleportToRole(Sheriff) end
	if TeleportHeroKey and input.KeyCode == TeleportHeroKey then TeleportToRole(Hero) end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then CtrlPressed = false end
end)

