local AntiAFKEnabled = false
local SessionStats = { StartTime=os.clock(), TotalCoins=0, SmoothedRate=0 }
local RATE_CONFIG = { MIN_ELAPSED=5, SMOOTHING=0.2 }
local HourHistory, MAX_HISTORY, CurrentHourStart, CurrentHourCoins = {}, 5, os.clock(), 0
local RoundMapId, RoundDied, MapCache, LastMapId, LastContainer = nil, false, nil, nil, nil

local ManualCoinCount = 0
local CountedCoins = setmetatable({}, {__mode="k"})
local MinDistToCoin = setmetatable({}, {__mode="k"})
local COUNT_PROXIMITY = 4

local function ResetCoinCounters()
	ManualCoinCount = 0
	CountedCoins = setmetatable({}, {__mode="k"})
	MinDistToCoin = setmetatable({}, {__mode="k"})
end

local function CountCoinIfCollected(coin)
	if not coin or CountedCoins[coin] then return end
	local v = coin:FindFirstChild("CoinVisual")
	local isCollected = false
	pcall(function() if coin:GetAttribute("Collected") == true then isCollected = true end end)
	if not isCollected and v then
		pcall(function() if v:GetAttribute("Collected") == true then isCollected = true end end)
	end
	if not isCollected then return end
	local minDist = MinDistToCoin[coin]
	if not minDist or minDist > COUNT_PROXIMITY then
		CountedCoins[coin] = true
		pcall(function() FarmCtl.Log("skip coin: min=" .. tostring(minDist and string.format("%.2f", minDist) or "nil")) end)
		return
	end
	CountedCoins[coin] = true
	ManualCoinCount = ManualCoinCount + 1
	SessionStats.TotalCoins = SessionStats.TotalCoins + 1
	CurrentHourCoins = CurrentHourCoins + 1
	pcall(function() FarmCtl.Log("coin #" .. ManualCoinCount .. " (min=" .. string.format("%.2f", minDist) .. ")") end)
end

local AutoReset = { Enabled = false, Done = false, EmptySince = nil, EMPTY_DELAY = 1.0 }

local FarmCtl = { Id=0, Tween=nil, Lines={}, NextSnap=0, Bounds=nil, BoundsFor=nil, BoundsSince=0, BlockedLogged=nil, SawCoins=false }

function FarmCtl.Log(msg)
	local line = os.date("%H:%M:%S") .. "  " .. tostring(msg)
	table.insert(FarmCtl.Lines, line)
	if #FarmCtl.Lines > 80 then table.remove(FarmCtl.Lines, 1) end
	if writefile then pcall(writefile, "AstroxHub_farmlog.txt", table.concat(FarmCtl.Lines, "\n")) end
end

function FarmCtl.InMap(hrp)
	local map = MapCache
	if not map or not map.Parent then return false end
	if FarmCtl.BoundsFor ~= map then
		FarmCtl.BoundsFor = map
		FarmCtl.Bounds = nil
		FarmCtl.BoundsSince = os.clock()
		FarmCtl.BlockedLogged = nil
		local ok, cf, size = pcall(function() return map:GetBoundingBox() end)
		if ok and cf and size then FarmCtl.Bounds = {cf=cf, size=size} end
	end
	local b = FarmCtl.Bounds
	if not b then return true end
	if os.clock() - FarmCtl.BoundsSince > 6 then return true end
	local rel = b.cf:PointToObjectSpace(hrp.Position)
	local m = 60
	local inside = math.abs(rel.X) <= b.size.X/2 + m and math.abs(rel.Y) <= b.size.Y/2 + m and math.abs(rel.Z) <= b.size.Z/2 + m
	if not inside and FarmCtl.BlockedLogged ~= map then FarmCtl.BlockedLogged = map; FarmCtl.Log("move blocked: char outside map bounds") end
	return inside
end

local function BindDeath(hum) if not hum then return end hum.Died:Connect(function() RoundDied = true end) end
local function GetChar() return LP.Character end
local function GetHRP() local c = LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid() local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end

local CoinFails, CoinSkips = {}, {}
local function CoinSkip(coin)
	local exp = CoinSkips[coin]
	if not exp then return false end
	if exp < tick() then CoinSkips[coin] = nil; CoinFails[coin] = nil; return false end
	return true
end
local function CoinFailed(coin)
	CoinFails[coin] = (CoinFails[coin] or 0) + 1
	if CoinFails[coin] >= 2 then CoinSkips[coin] = tick() + 20 end
end
local function CoinReset() CoinFails = {}; CoinSkips = {} end

local function GetMap()
	if MapCache and MapCache.Parent and MapCache:GetAttribute("MapID") then
		local container = MapCache:FindFirstChild("CoinContainer")
		if container and container ~= LastContainer then
			LastContainer = container
			RoundDied = false
			AutoReset.Done = false
			AutoReset.EmptySince = nil
			CoinReset()
			FarmCtl.SawCoins = false
			ResetCoinCounters()
		end
		return MapCache
	end
	MapCache = nil
	while IsFarming and ScriptEnabled do
		for _, obj in ipairs(workspace:GetChildren()) do
			if obj:GetAttribute("MapID") then
				MapCache = obj
				local newId = obj:GetAttribute("MapID")
				local container = obj:FindFirstChild("CoinContainer")
				if newId ~= LastMapId or (container and container ~= LastContainer) then
					LastMapId = newId; LastContainer = container
					RoundDied = false; RoundMapId = newId
					AutoReset.Done = false
					AutoReset.EmptySince = nil
					CoinReset()
					FarmCtl.SawCoins = false
					ResetCoinCounters()
					task.spawn(function() local char = GetChar(); if char then local hum = char:WaitForChild("Humanoid", 5); if hum then BindDeath(hum) end end end)
				end
				return obj
			end
		end
		task.wait()
	end
	return nil
end

local function CalculateRawCPH() local elapsed = os.clock() - SessionStats.StartTime; if elapsed < RATE_CONFIG.MIN_ELAPSED then return 0 end; return (SessionStats.TotalCoins / elapsed) * 3600 end

local function BuildHistoryText()
	local parts = {}
	for i, h in ipairs(HourHistory) do table.insert(parts, i .. "h: " .. h.coins) end
	local hourElapsed = os.clock() - CurrentHourStart
	local curMin = math.floor(hourElapsed / 60)
	local currentHourNum = #HourHistory + 1
	if CurrentHourCoins > 0 or curMin > 0 then table.insert(parts, currentHourNum .. "h(" .. curMin .. "m): " .. CurrentHourCoins) end
	if #parts == 0 then return T("stats_hist_empty") end
	return T("stats_hist") .. table.concat(parts, " | ")
end

local function WasCollected(coin, visual)
	if not coin or not coin.Parent then return true end
	if not visual or not visual.Parent then return true end
	if visual:GetAttribute("Collected") == true then return true end
	if coin:GetAttribute("Collected") == true then return true end
	return false
end

local function CountCoinsLeftInMap()
	local map = MapCache
	if not map or not map.Parent then return -1 end
	local container = map:FindFirstChild("CoinContainer")
	if not container then return -1 end
	local count = 0
	for _, coin in ipairs(container:GetChildren()) do
		local v = coin:FindFirstChild("CoinVisual")
		if v and v.Parent and coin.Parent and not WasCollected(coin, v) then
			count = count + 1
		end
	end
	return count
end

local function GetNearestCoin(hrp)
	local map = GetMap()
	if not map or not map:FindFirstChild("CoinContainer") then return nil end
	if not hrp then return nil end
	local container = map.CoinContainer
	local closest, closestDist = nil, math.huge
	for _, coin in ipairs(container:GetChildren()) do
		local v = coin:FindFirstChild("CoinVisual")
		if v and v.Parent and coin.Parent and not WasCollected(coin, v) and not CoinSkip(coin) then
			local d = (hrp.Position - coin.Position).Magnitude
			if d < closestDist then closest = coin; closestDist = d end
		end
	end
	return closest
end

local function GetUnderMapCF()
	local map = MapCache
	if not map or not map.Parent then return nil end
	local spawns = map:FindFirstChild("Spawns")
	local pos = nil
	if spawns then
		for _, s in ipairs(spawns:GetChildren()) do if s:IsA("BasePart") then pos = s.Position; break end end
	end
	if not pos then
		local ok, cf = pcall(function() return map:GetPivot() end)
		if ok and cf then pos = cf.Position end
	end
	if not pos then return nil end
	return CFrame.new(pos.X, pos.Y - 15, pos.Z)
end

