FarmPhysics = { Active=false, ClipWas={}, BodyGyro=nil, BodyVelocity=nil, OldPlatformStand=false }

function FarmPhysics.NoclipOn()
	local char = GetChar()
	if not char then return end
	for _, p in pairs(char:GetDescendants()) do
		if p:IsA("BasePart") and p.CanCollide then
			if FarmPhysics.ClipWas[p] == nil then FarmPhysics.ClipWas[p] = true end
			p.CanCollide = false
		end
	end
end

function FarmPhysics.NoclipOff()
	for p in pairs(FarmPhysics.ClipWas) do
		pcall(function() if p and p.Parent then p.CanCollide = true end end)
	end
	FarmPhysics.ClipWas = {}
end

function FarmPhysics.On()
	if FarmPhysics.Active then return end
	local char = GetChar()
	if not char then return end
	local upper = char:FindFirstChild("UpperTorso")
	if not upper then upper = char:FindFirstChild("HumanoidRootPart") end
	if not upper then return end
	if upper:FindFirstChild("AstroxFarmGyro") then
		FarmPhysics.BodyGyro = upper:FindFirstChild("AstroxFarmGyro")
		FarmPhysics.BodyVelocity = upper:FindFirstChild("AstroxFarmVel")
		FarmPhysics.Active = true
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	FarmPhysics.OldPlatformStand = hum.PlatformStand
	local cFrame = hrp.CFrame
	local cFrame2 = CFrame.new(cFrame.X, cFrame.Y, cFrame.Z) * CFrame.Angles(math.pi/2, 0, math.pi/2)
	FarmPhysics.NoclipOn()
	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "AstroxFarmGyro"; bodyGyro.Parent = upper; bodyGyro.P = 90000; bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bodyGyro.CFrame = cFrame2
	FarmPhysics.BodyGyro = bodyGyro
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "AstroxFarmVel"; bodyVelocity.Parent = upper; bodyVelocity.Velocity = Vector3.zero; bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	FarmPhysics.BodyVelocity = bodyVelocity
	hrp.CFrame = cFrame2
	hum.PlatformStand = true
	FarmPhysics.Active = true
	FarmCtl.Log("farm physics: ON")
end

function FarmPhysics.Off()
	if not FarmPhysics.Active then return end
	local char = GetChar()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		if FarmPhysics.BodyGyro then pcall(function() FarmPhysics.BodyGyro:Destroy() end); FarmPhysics.BodyGyro = nil end
		if FarmPhysics.BodyVelocity then pcall(function() FarmPhysics.BodyVelocity:Destroy() end); FarmPhysics.BodyVelocity = nil end
		pcall(function() hum.PlatformStand = false end)
		FarmPhysics.NoclipOff()
	end
	local hrp = GetHRP()
	if hrp then pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero end) end
	FarmPhysics.Active = false
	FarmCtl.Log("farm physics: OFF")
end

RunService.Stepped:Connect(function()
	if not FarmPhysics.Active then return end
	local char = GetChar()
	if char then
		for _, p in pairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				if FarmPhysics.ClipWas[p] == nil then FarmPhysics.ClipWas[p] = true end
