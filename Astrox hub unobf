local CurrentCoin = nil
local FarmTargetTime = 0
local PushStartTime = 0

local function MoveToCoin(hp)
	local hrp = GetHRP()
	local hum = GetHumanoid()
	if not hrp or not hum then return end
	FarmPhysics.On()
	local speed = math.min(FarmSpeed, 23)
	local duration = (hrp.Position - hp.Position).Magnitude / speed
	if duration > 15 then duration = 3 end
	if duration < 0.05 then duration = 0.05 end
	local cFrame = hp.CFrame
	local targetCFrame = CFrame.new(cFrame.X, cFrame.Y - 3.5, cFrame.Z) * CFrame.Angles(math.pi/2, 0, math.pi/2)
	if FarmPhysics.BodyGyro and FarmPhysics.BodyGyro.Parent then
		pcall(function() FarmPhysics.BodyGyro.CFrame = targetCFrame end)
	end
	if FarmCtl.Tween then pcall(function() FarmCtl.Tween:Cancel() end); FarmCtl.Tween = nil end
	hrp.Velocity = Vector3.zero
	local t = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
	FarmCtl.Tween = t
	t:Play()
	hrp.Velocity = Vector3.zero
end

do
	local autoFarmStatsParagraph = Tabs.AutoFarm:Paragraph({ Title=T("stats"), Desc=T("stats_desc"), Image="activity", ImageSize=32 })
